{
  "devDependencies": {
    "prettier": "3.9.10",
    "renovate": "43.204.1"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "format": "prettier --log-level warn --no-error-on-unmatched-pattern --write '**/*.yml' '**/*.json' '**/*.md' pnpm-workspace.yaml",
    "check-format": "prettier --no-error-on-unmatched-pattern --check '**/*.yml' '**/*.json' '**/*.md' pnpm-workspace.yaml"
  }
}
